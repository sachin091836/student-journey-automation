      "id": "185288d9-b00a-5838-ad69-b0f2435cf39f",
      "name": "Purchase · Woo / GHL / Stripe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        460
      ],
      "webhookId": "d86f590b-aef3-57b0-a9dd-8555f3874bc7",
